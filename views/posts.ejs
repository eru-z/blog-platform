<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>All Posts | AI Blog</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<style>
  body {
    margin:0;
    font-family:'Poppins',sans-serif;
    background: linear-gradient(135deg,#0f0f0f,#1a1a2e,#3a0ca3,#7209b7);
    color:#fff;
    min-height:100vh;
    padding:2rem;
  }
  .header {
    text-align:center;
    margin-bottom:2rem;
  }
  .header h2 {
    font-size:2rem;
    background:linear-gradient(90deg,#ff6ec4,#ffd700,#00f5d4);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
  }
  .cards-container {
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:1.5rem;
  }
  .card {
    background:rgba(255,255,255,0.03);
    backdrop-filter: blur(25px);
    border-radius:1.5rem;
    overflow:hidden;
    box-shadow:0 15px 40px rgba(0,0,0,0.8);
    display:flex;
    flex-direction:column;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .card:hover {
    transform:translateY(-5px);
    box-shadow:0 20px 50px rgba(255,110,196,0.5);
  }
  .card img {
    width:100%;
    height:180px;
    object-fit:cover;
  }
  .card-content {
    padding:1rem 1.2rem;
    flex:1;
    display:flex;
    flex-direction:column;
    gap:0.5rem;
  }
  .card-title {
    font-size:1.3rem;
    font-weight:600;
    color:#ff6ec4;
  }
  .card-excerpt {
    font-size:0.95rem;
    flex:1;
    color:#fff;
  }
  .card-meta {
    font-size:0.85rem;
    color:#ffd700;
    display:flex;
    justify-content:space-between;
    margin-top:0.5rem;
  }
  .card-actions {
    display:flex;
    gap:0.5rem;
    margin-top:0.8rem;
  }
  .btn-edit, .btn-delete {
    padding:0.4rem 0.8rem;
    border-radius:0.5rem;
    font-size:0.85rem;
    font-weight:600;
    text-decoration:none;
    transition:0.3s;
    color:#fff;
    text-align:center;
  }
  .btn-edit {
    background:#00b894;
  }
  .btn-edit:hover { box-shadow:0 0 10px #00b894; transform:translateY(-2px);}
  .btn-delete {
    background:#d63031;
  }
  .btn-delete:hover { box-shadow:0 0 10px #d63031; transform:translateY(-2px);}
  a.back-home {
    display:inline-block;
    margin:1rem 0;
    padding:0.5rem 1rem;
    border-radius:0.75rem;
    background:linear-gradient(90deg,#ff6ec4,#ffd700);
    color:#1a1a2e;
    font-weight:600;
    text-decoration:none;
    transition:0.3s;
  }
  a.back-home:hover {
    box-shadow:0 0 12px #ff6ec4;
    transform:translateY(-2px);
  }
</style>
</head>
<body>
  <% if(user){ %>
    <div class="header">
      Logged in as <strong><%= user.username %></strong> | <a href="/logout" style="color:#ff6ec4;">Logout</a>
    </div>
  <% } %>

  <a href="/create" class="back-home">← Create New Post</a>
  <div class="header">
    <h2>All Posts</h2>
  </div>

  <div class="cards-container">
    <% posts.forEach(post => { %>
      <div class="card">
        <% if(post.image){ %>
          <img src="<%= post.image %>" alt="Post Image">
        <% } else { %>
          <img src="https://picsum.photos/400/250?random=<%= post.id %>" alt="Placeholder">
        <% } %>
        <div class="card-content">
          <div class="card-title"><%= post.title %></div>
          <div class="card-excerpt"><%= post.excerpt %></div>
          <div class="card-meta">
            <span><%= post.author %></span>
            <span><%= post.date.toLocaleDateString() %></span>
          </div>
          <div class="card-actions">
            <a href="/edit/<%= post.id %>" class="btn-edit">Edit</a>
            <a href="/delete/<%= post.id %>" class="btn-delete" onclick="return confirm('Are you sure?')">Delete</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <a href="/" class="back-home">← Back to Home</a>
</body>
</html>
