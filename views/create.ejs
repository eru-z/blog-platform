<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create New Post | AI Blog</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
  <style>
    body {
      margin:0; font-family:'Poppins',sans-serif;
      background: linear-gradient(135deg,#0f0f0f,#1a1a2e,#3a0ca3,#7209b7);
      color:#fff; min-height:100vh; display:flex; justify-content:center; padding:2rem;
    }
    .create-container {
      width:100%; max-width:620px; background:rgba(255,255,255,0.03);
      backdrop-filter: blur(25px); border-radius:1.5rem; padding:2rem;
      box-shadow:0 15px 40px rgba(0,0,0,0.8);
    }
    h2 {
      font-size:2rem; text-align:center; margin-bottom:2rem;
      background:linear-gradient(90deg,#ff6ec4,#ffd700,#00f5d4);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    }
    .user-info { text-align:right; margin-bottom:1rem; color:#ff6ec4; }
    form { display:flex; flex-direction:column; gap:1rem; }
    .row { display:flex; gap:1rem; flex-wrap:wrap; }
    .input-group { flex:1; display:flex; flex-direction:column; position:relative; }
    .input-group input, .input-group textarea {
      padding:0.75rem 1rem; border-radius:0.75rem;
      border:1px solid rgba(255,255,255,0.2);
      background:rgba(255,255,255,0.05); color:#fff; font-size:0.95rem; transition:0.3s;
    }
    .input-group input:focus, .input-group textarea:focus {
      outline:none; border:1px solid #ff6ec4; box-shadow:0 0 12px rgba(255,110,196,0.6);
    }
    .input-group label {
      position:absolute; top:-10px; left:15px; font-size:0.75rem;
      background:rgba(15,15,15,0.8); padding:0 0.25rem; color:#ff6ec4;
    }
    textarea { resize:vertical; min-height:150px; }
    #editor { height:220px; border-radius:0.75rem; background:rgba(255,255,255,0.05); }
    .file-input-wrapper { position:relative; }
    .file-input-wrapper input[type="file"] { opacity:0; position:absolute; width:100%; height:100%; cursor:pointer; }
    .file-label {
      padding:0.65rem 1rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.2);
      background:rgba(255,255,255,0.05); cursor:pointer; text-align:center; color:#fff; transition:0.3s;
    }
    .file-label:hover { border-color:#ff6ec4; box-shadow:0 0 10px rgba(255,110,196,0.5); }
    .optional-section {
      background:rgba(255,255,255,0.03); padding:0.75rem 1rem;
      border-radius:1rem; margin-top:0.5rem; cursor:pointer; transition:0.3s;
    }
    .optional-header { display:flex; justify-content:space-between; font-weight:600; color:#ff6ec4; user-select:none; }
    .optional-content { display:none; margin-top:0.7rem; }
    .buttons { display:flex; gap:1rem; margin-top:1.2rem; justify-content:flex-end; }
    .btn { padding:0.7rem 1.5rem; border:none; border-radius:50px; font-weight:600; cursor:pointer; transition:0.3s; }
    .btn-draft { background:#555; color:#fff; }
    .btn-draft:hover { box-shadow:0 0 12px #fff; transform:translateY(-2px);}
    .btn-publish { background:linear-gradient(90deg,#ff6ec4,#ffd700); color:#1a1a2e; }
    .btn-publish:hover { box-shadow:0 0 18px #ff6ec4; transform:translateY(-2px); }
    #file-name { margin-left:10px; font-size:0.85rem; color:#fff; }
  </style>
</head>
<body>
  <div class="create-container">
    <% if(user){ %>
      <div class="user-info">Logged in as <strong><%= user.username %></strong> | <a href="/logout" style="color:#ff6ec4;">Logout</a></div>
    <% } %>
    <h2>Create New Post</h2>
    <form action="/create" method="POST" enctype="multipart/form-data">
      <div class="row">
        <div class="input-group">
          <label for="title">Title</label>
          <input type="text" name="title" id="title" required placeholder="Post title">
        </div>
        <div class="input-group">
          <label for="category">Category / Tags</label>
          <input type="text" name="category" id="category" placeholder="AI, Tech" required>
        </div>
      </div>
      <div class="input-group">
        <label for="excerpt">Excerpt / Summary</label>
        <textarea name="excerpt" id="excerpt" placeholder="Write a short summary" required></textarea>
      </div>
      <div class="input-group">
        <label for="body">Body</label>
        <div id="editor"></div>
        <input type="hidden" name="body" id="hidden-body">
      </div>
      <div class="input-group file-input-wrapper">
        <label class="file-label" for="image">Upload Image</label>
        <input type="file" name="image" id="image" accept="image/*" onchange="showFileName(this)">
        <span id="file-name"></span>
      </div>
      <div class="optional-section" onclick="toggleSection('ai-content')">
        <div class="optional-header">AI Suggestions <span>+</span></div>
        <div class="optional-content" id="ai-content">Suggest titles, summaries, or improve readability...</div>
      </div>
      <div class="optional-section" onclick="toggleSection('seo-content')">
        <div class="optional-header">SEO Optimization <span>+</span></div>
        <div class="optional-content" id="seo-content">
          <div class="row">
            <div class="input-group">
              <label for="meta-description">Meta Description</label>
              <input type="text" name="meta_description" id="meta-description" placeholder="Max 160 chars">
            </div>
            <div class="input-group">
              <label for="keywords">Keywords</label>
              <input type="text" name="keywords" id="keywords" placeholder="AI, Blogging, Node.js">
            </div>
          </div>
        </div>
      </div>
      <div class="buttons">
        <button type="submit" name="action" value="draft" class="btn btn-draft">Save Draft</button>
        <button type="submit" name="action" value="publish" class="btn btn-publish">Publish</button>
      </div>
    </form>
  </div>
  <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
  <script>
    var quill = new Quill('#editor', { theme: 'snow' });
    const form = document.querySelector('form');
    form.onsubmit = function() {
      document.querySelector('#hidden-body').value = quill.root.innerHTML;
    };

    function toggleSection(id) {
      const content = document.getElementById(id);
      const span = content.previousElementSibling.querySelector('span');
      if(content.style.display === 'block'){
        content.style.display = 'none';
        if(span) span.textContent = '+';
      } else {
        content.style.display = 'block';
        if(span) span.textContent = '−';
      }
    }

    function showFileName(input) {
      const fileName = input.files[0]?.name || '';
      document.getElementById('file-name').textContent = fileName;
    }
  </script>
  
</body>
</html>
