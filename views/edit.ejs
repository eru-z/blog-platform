<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Post | AI Blog</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<style>
  body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg,#0f0f0f,#1a1a2e,#3a0ca3,#7209b7);
    color: #fff;
    min-height: 100vh;
    padding: 2rem;
  }
  .header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .header h2 {
    font-size: 2rem;
    background: linear-gradient(90deg,#ff6ec4,#ffd700,#00f5d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  form {
    max-width: 700px;
    margin: 0 auto;
    background: rgba(255,255,255,0.03);
    padding: 2rem;
    border-radius: 1.5rem;
    backdrop-filter: blur(25px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  input[type="text"], textarea, input[type="file"] {
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(255,255,255,0.3);
    outline: none;
    font-size: 1rem;
    background: transparent;
    color: #fff;
  }
  textarea { min-height: 120px; resize: vertical; }
  input::placeholder, textarea::placeholder {
    color: rgba(255,255,255,0.6);
  }
  button {
    padding: 0.8rem 1rem;
    border: none;
    border-radius: 0.8rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }
  button[name="action"][value="draft"] {
    background: #ff6ec4;
    color: #fff;
  }
  button[name="action"][value="draft"]:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255,110,196,0.5);
  }
  button[name="action"][value="publish"] {
    background: #00f5d4;
    color: #000;
  }
  button[name="action"][value="publish"]:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,245,212,0.5);
  }
  a.back-home {
    display:inline-block;
    margin-bottom:1rem;
    color:#ff6ec4;
    text-decoration:none;
    font-weight:600;
  }
  a.back-home:hover { text-decoration:underline; }
  #editor {
    height: 250px;
    background: rgba(255,255,255,0.05);
    color: #fff;
    border-radius: 0.8rem;
  }
  .ql-toolbar.ql-snow, .ql-container.ql-snow {
    border-radius: 0.8rem;
    background: rgba(255,255,255,0.05);
    color: #fff;
  }
</style>

</head>
<body>

  <% if(user){ %>
    <div class="header">
      Logged in as <strong><%= user.username %></strong> | <a href="/logout" style="color:#ff6ec4;">Logout</a>
    </div>
  <% } %>

  <a href="/posts" class="back-home">← Back to Posts</a>
  <div class="header">
    <h2>Edit Post</h2>
  </div>

  <form action="/edit/<%= post.id %>" method="POST" enctype="multipart/form-data">
    <input type="text" name="title" placeholder="Title" value="<%= post.title %>" required>
    <input type="text" name="category" placeholder="Category" value="<%= post.category %>" required>
    <textarea name="excerpt" placeholder="Excerpt" required><%= post.excerpt %></textarea>
    <div id="editor"><%- post.body %></div>
    <input type="hidden" name="body" id="hidden-body">
    <input type="file" name="image">
    <div style="display:flex; gap:1rem;">
      <button type="submit" name="action" value="draft">Save Draft</button>
      <button type="submit" name="action" value="publish">Publish</button>
    </div>
  </form>

<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
  var quill = new Quill('#editor', { theme: 'snow' });
  document.querySelector('form').onsubmit = function() {
    document.querySelector('#hidden-body').value = quill.root.innerHTML;
  }
</script>

</body>
</html>
